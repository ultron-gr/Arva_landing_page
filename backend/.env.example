# ARVA Studios — backend environment (server-only; never expose to the browser)
# Copy to backend/.env and fill in real values. Never commit real values.

# Supabase project (Postgres, studio_site schema)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Resend transactional email
RESEND_API_KEY=re_YOUR_KEY
RESEND_FROM_EMAIL=onboarding@resend.dev
INTERNAL_NOTIFICATION_EMAIL=you@yourdomain.com

# Sentry — BACKEND project DSN (separate Sentry project from the frontend)
SENTRY_DSN=https://YOUR-BACKEND-DSN@oXXXX.ingest.sentry.io/XXXX

# Salt for one-way hashing of submitter IPs (any random string)
IP_HASH_SALT=change-me-random-string

# CORS origins, comma-separated ("*" for dev)
CORS_ORIGINS=*

# QA only — enables X-Simulate test header for db/email failure paths. Keep false in production.
ALLOW_TEST_SIMULATION=false
