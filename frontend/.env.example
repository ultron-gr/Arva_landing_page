# ARVA Studios — frontend environment (client-exposed, VITE_ prefix per Vite convention)
# Copy to frontend/.env and fill in real values. Never commit real values.

# Supabase — anon key only (read/write is blocked by RLS; used solely for Auth init)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# External Google Calendar scheduling link. Leave empty until you have a real one —
# the "Book a Call" button shows a "Calendar link coming soon" state when unset.
VITE_CALENDAR_LINK=

# Sentry — FRONTEND project DSN (separate Sentry project from the backend)
VITE_SENTRY_DSN=https://YOUR-FRONTEND-DSN@oXXXX.ingest.sentry.io/XXXX

# Platform-managed — do not change
REACT_APP_BACKEND_URL=https://your-app.preview.emergentagent.com
